# Server-side Vercel environment variables. Never use VITE_* for secrets.
# Configure Preview and Production separately; redeploy after changes.
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
SPEAKLAB_SESSION_SECRET="replace-with-base64-of-at-least-32-random-bytes"
GEMINI_API_KEY="your-server-side-gemini-api-key"
# Manual confirmation of your Google AI project/tier. Not a billing verification.
SPEAKLAB_GEMINI_FREE_TIER_CONFIRMED="true"
# Deliberate Production-only opt-in. Leave false until ready.
SPEAKLAB_GEMINI_PRODUCTION_ENABLED="false"
# Fail-closed server-side daily quota; mandatory for AI calls.
SPEAKLAB_RATE_LIMIT_REST_URL="https://your-upstash-rest-endpoint.upstash.io"
SPEAKLAB_RATE_LIMIT_REST_TOKEN="your-upstash-rest-token"
